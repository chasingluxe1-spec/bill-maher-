# Crime Documentary Pipeline — environment template.
# Copy to .env and fill. NEVER commit .env. Real image keys were copied from billii mori.

# --- Images ---
SERPER_API_KEY=            # google image search (real photos of the specific victim/place/document)
PEXELS_API_KEY=            # rights-clean mood / establishing b-roll
PIXABAY_API_KEY=           # rights-clean stock

# --- Model router (proxy holds Codex/Grok/Kimi logins; Gemini via agy) ---
MODEL_ROUTER_URL=http://127.0.0.1:8317
MODEL_ROUTER_KEY=          # api-keys entry from cli-proxy-api config.yaml
MODEL_ROUTER_MODEL=gpt-5.6-sol
MODEL_ROUTER_EFFORT=low
AGY_WORKER_MODEL=gemini-3.6-flash

# --- Pocket TTS (local, CPU venv — no key needed, paths only) ---
POCKET_TTS_DIR=d:/antigravity test/faceless-studio
POCKET_TTS_VENV=d:/antigravity test/faceless-studio/.venv-tts/Scripts/python.exe
VOICE_REF=assets/voice/voice_preview_true - crime & horror narrator.mp3
